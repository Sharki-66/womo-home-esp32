/**
 * @file womo_credentials.h.example
 * @brief Template für WiFi-Zugangsdaten
 *
 * Kopiere diese Datei nach womo_credentials.h und trage die
 * tatsächlichen Werte ein:
 *
 *   cp womo_credentials.h.example womo_credentials.h
 *
 * womo_credentials.h ist in .gitignore eingetragen und wird NICHT committed.
 */
#pragma once

#define WOMO_WIFI_DEFAULT_SSID  "DEINE-SSID"
#define WOMO_WIFI_DEFAULT_PASS  "DEIN-PASSWORT"

/* ESP-NOW-Verschlüsselung (CCMP/AES-128): je genau 16 Zeichen, auf Display
 * und Sensorboard identisch (beide binden diese Datei ein). Eigene Zufallswerte
 * erzeugen, z. B.:
 *   python3 -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(16)))"
 * Nach einer Änderung beide Boards neu flashen. */
#define WOMO_ESPNOW_PMK         "0123456789ABCDEF"
#define WOMO_ESPNOW_LMK         "FEDCBA9876543210"

/* Service-PIN fürs Display (Titel „Einstellungen“ 5 s drücken → Servicebereich;
 * gilt auch als Ausweg bei vergessenem AP-Passwort). Genau 4 Ziffern. */
#define WOMO_SERVICE_PIN        "0000"
