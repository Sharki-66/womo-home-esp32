{
  "folders": [
    {
      "name": "GasBee nRF (XIAO nRF52840) - MAIN",
      "path": "firmware/gasbee_nrf"
    },
    {
      "name": "GasBee (ESP32-C3) - REF",
      "path": "firmware/gasbee"
    }
  ],
  "settings": {
    "files.associations": { "*.h": "c", "*.c": "c", "*.overlay": "dts", "*.conf": "properties" },
    "C_Cpp.default.compileCommands": "${workspaceFolder:GasBee nRF (XIAO nRF52840) - MAIN}/build/gasbee_nrf/compile_commands.json",
    "files.defaultLanguage": "c",
    "explorer.sortOrder": "foldersNestsFiles",
    "idf.showOnboardingOnInit": false,
    "chat.agent.maxRequests": 50
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build GasBee nRF (Testmodus)",
        "detail": "Status-LED an, Messintervall 60 s (debug.conf)",
        "type": "shell",
        "command": "~/.vscode/extensions/nordic-semiconductor.nrf-connect-*/platform/nrfutil/bin/nrfutil-sdk-manager toolchain launch --ncs-version v3.4.1 -- env ZEPHYR_BASE=$HOME/ncs/v3.4.1/zephyr west build -p always -b xiao_ble -d build . -- -DEXTRA_CONF_FILE=debug.conf",
        "options": { "cwd": "${workspaceFolder:GasBee nRF (XIAO nRF52840) - MAIN}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" },
        "presentation": { "reveal": "always", "panel": "shared", "clear": true }
      },
      {
        "label": "Build GasBee nRF (Normalbetrieb)",
        "detail": "Status-LED aus, Messintervall 300 s",
        "type": "shell",
        "command": "~/.vscode/extensions/nordic-semiconductor.nrf-connect-*/platform/nrfutil/bin/nrfutil-sdk-manager toolchain launch --ncs-version v3.4.1 -- env ZEPHYR_BASE=$HOME/ncs/v3.4.1/zephyr west build -p always -b xiao_ble -d build .",
        "options": { "cwd": "${workspaceFolder:GasBee nRF (XIAO nRF52840) - MAIN}" },
        "group": "build",
        "problemMatcher": { "base": "$gcc", "fileLocation": "absolute" },
        "presentation": { "reveal": "always", "panel": "shared", "clear": true }
      },
      {
        "label": "Flash GasBee nRF (UF2)",
        "detail": "Vorher Reset 2x drücken, dann erscheint das Laufwerk XIAO-SENSE",
        "type": "shell",
        "command": "uf2=build/gasbee_nrf/zephyr/zephyr.uf2; drv=/media/$USER/XIAO-SENSE; [ -f \"$uf2\" ] || { echo \"$uf2 fehlt – erst bauen.\"; exit 1; }; [ -d \"$drv\" ] || { echo \"$drv nicht gefunden – Reset am XIAO 2x schnell drücken und Task erneut starten.\"; exit 1; }; cp -v \"$uf2\" \"$drv/\" && sync && echo 'Fertig. Der XIAO startet neu, das Laufwerk verschwindet (normal).'",
        "options": { "cwd": "${workspaceFolder:GasBee nRF (XIAO nRF52840) - MAIN}" },
        "group": "build",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "shared", "clear": false }
      },
      {
        "label": "Monitor GasBee nRF",
        "detail": "tools/gasbee-monitor.sh, Beenden mit Strg+]",
        "type": "shell",
        "command": "${workspaceFolder:GasBee nRF (XIAO nRF52840) - MAIN}/../../tools/gasbee-monitor.sh",
        "problemMatcher": [],
        "isBackground": true,
        "presentation": { "reveal": "always", "panel": "dedicated", "focus": true, "clear": true }
      },
      {
        "label": "Clean GasBee nRF",
        "type": "shell",
        "command": "rm -rf build",
        "options": { "cwd": "${workspaceFolder:GasBee nRF (XIAO nRF52840) - MAIN}" },
        "group": "build",
        "problemMatcher": [],
        "presentation": { "reveal": "always", "panel": "shared", "clear": true }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "nordic-semiconductor.nrf-connect-extension-pack",
      "ms-vscode.cpptools"
    ]
  }
}
