{
        "folders": [
                {
                        "name": "📺 Display (firmware) - READ-ONLY",
                        "path": "firmware"
                },
                {
                        "path": "firmware-modem"
                },
                {
                        "path": "firmware-sensor"
                },
                {
                        "path": "."
                }
        ],
        "settings": {
                "idf.port": "/dev/ttyACM1",
                "idf.flashType": "UART",
                "idf.openOcdConfigs": [
                        "board/esp32s3-builtin.cfg"
                ],
                "files.associations": {
                        "*.h": "c",
                        "*.c": "c"
                }
        },
        "tasks": {
                "version": "2.0.0",
                "tasks": [
                        {
                                "label": "Build Modem Firmware",
                                "type": "shell",
                                "command": "idf.py",
                                "args": ["build"],
                                "options": {
                                        "cwd": "${workspaceFolder:🔌 Modem (firmware-modem) - MAIN}"
                                },
                                "group": {
                                        "kind": "build",
                                        "isDefault": true
                                },
                                "problemMatcher": ["$gcc"],
                                "presentation": {
                                        "echo": true,
                                        "reveal": "always",
                                        "focus": false,
                                        "panel": "shared",
                                        "showReuseMessage": false,
                                        "clear": false
                                }
                        },
                        {
                                "label": "Flash Modem Firmware",
                                "type": "shell",
                                "command": "idf.py",
                                "args": ["-p", "/dev/ttyACM1", "flash"],
                                "options": {
                                        "cwd": "${workspaceFolder:🔌 Modem (firmware-modem) - MAIN}"
                                },
                                "group": "build",
                                "problemMatcher": [],
                                "presentation": {
                                        "echo": true,
                                        "reveal": "always",
                                        "focus": false,
                                        "panel": "shared",
                                        "showReuseMessage": false,
                                        "clear": false
                                }
                        },
                        {
                                "label": "Monitor Modem",
                                "type": "shell",
                                "command": "idf.py",
                                "args": ["-p", "/dev/ttyACM1", "monitor"],
                                "options": {
                                        "cwd": "${workspaceFolder:🔌 Modem (firmware-modem) - MAIN}"
                                },
                                "group": "build",
                                "problemMatcher": [],
                                "isBackground": true,
                                "presentation": {
                                        "echo": true,
                                        "reveal": "always",
                                        "focus": true,
                                        "panel": "dedicated",
                                        "showReuseMessage": false,
                                        "clear": false
                                }
                        },
                        {
                                "label": "Build + Flash + Monitor Modem",
                                "type": "shell",
                                "command": "idf.py",
                                "args": ["-p", "/dev/ttyACM1", "build", "flash", "monitor"],
                                "options": {
                                        "cwd": "${workspaceFolder:🔌 Modem (firmware-modem) - MAIN}"
                                },
                                "group": "build",
                                "problemMatcher": ["$gcc"],
                                "isBackground": true,
                                "presentation": {
                                        "echo": true,
                                        "reveal": "always",
                                        "focus": true,
                                        "panel": "dedicated",
                                        "showReuseMessage": false,
                                        "clear": false
                                }
                        },
                        {
                                "label": "Clean Modem Build",
                                "type": "shell",
                                "command": "idf.py",
                                "args": ["fullclean"],
                                "options": {
                                        "cwd": "${workspaceFolder:🔌 Modem (firmware-modem) - MAIN}"
                                },
                                "group": "build",
                                "problemMatcher": [],
                                "presentation": {
                                        "echo": true,
                                        "reveal": "always",
                                        "focus": false,
                                        "panel": "shared",
                                        "showReuseMessage": false,
                                        "clear": false
                                }
                        }
                ]
        }
}
