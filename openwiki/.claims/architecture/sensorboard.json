        }
      ]
    },
    {
      "id": "claim_2d391b3ded784afdbef31c51453c0da3",
      "statement": "GPIO14 reports the measured 12V house-battery bus state for the ctrl.pwr_on field once SENSOR_PWR_12V_SENSE_ENABLE is set; for 2.5s (SENSOR_PWR_12V_SENSE_GRACE_MS) after each relay pulse the commanded state is reported instead of the raw sense reading, and the sense pin's active polarity is an unverified TODO in source.",
      "evidence": [
