  "claims": [
    {
      "id": "claim_b30c7c94c15046b59079c280b017a49e",
      "statement": "The Sensorboard runs ESP-IDF v5.5.2 on an ESP32-S3-WROOM-1 (N16R8) module and acts as the vehicle-side data-acquisition node, reading BNO055/BME680/BME280/HX711/INA226/PCF8523 sensors, driving power-control GPIOs, scanning BLE peripherals, and serving a local web dashboard.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/README.md#L1-L21",
          "version": "repo-lines-v1:sha256:35a9da6d4679af2477ecd76445e5600e27b8c1eeca2c20b8604d6a66b5f42af8:"
        }
      ]
    },
    {
      "id": "claim_4a6cc185f52f43c093a10a7f305d95e5",
      "statement": "The Display-link transport has migrated from a wired RS485 UART (TX=GPIO9, RX=GPIO10, DE=GPIO8) to an ESP-NOW wireless transport (network/espnow_modem.c, network/espnow_transport.c); GPIO8 is only held LOW as a legacy floating-pin guard, while README.md/CLAUDE.md/memory-bank still describe the topic protocol under the historical RS485 name.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/app_main.c#L23-L23",
          "version": "repo-lines-v1:sha256:95f00ce0f1c33173213d13b4c829ae27c129e70a3b3a281d5356ca74b786e4d2:"
