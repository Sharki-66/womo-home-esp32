    {
      "id": "claim_72d9ab8bc30c44338cefb2cd5b37670c",
      "statement": "A known hardware bug (2026-09) populates the J7 relay driver FETs Q1/Q2 for 12V ON/OFF as P-channel high-side switches (IRLML2244) where the EBL expects an N-channel low-side pull-to-GND, so the 12V relay does not switch regardless of pulse length or sense wiring; the identified fix is a same-footprint swap to IRLML6244, not yet verified on hardware.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/sensor_config.h#L226-L245",
          "version": "repo-lines-v1:sha256:d539e360276f9a0bd7e40f17df50abe7985dab0eca0cee93e370374b9c18772e:"
        },
        {
