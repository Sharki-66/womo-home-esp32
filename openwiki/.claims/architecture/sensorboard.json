    {
      "id": "claim_e9bcfa7bdf864be9a86d065de360960f",
      "statement": "The 12V house-battery bus is switched by a bistable relay via GPIO11 (ON) / GPIO12 (OFF), each pulsed for SENSOR_PWR_12V_PULSE_MS (500 ms) from a single shared constant used at boot, at runtime, and on deep-sleep entry; both pins must idle LOW since an accidental pulse toggles the bus.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/CLAUDE.md#L16-L17",
          "version": "repo-lines-v1:sha256:2670dae14a5d9d232129a9ec570bc4ed40bb07a1dd9b5c9ed44416358cf5ef33:"
        },
