        }
      ]
    },
    {
      "id": "claim_570168950e4243099c0b9a33b409cd85",
      "statement": "BME680 IAQ/eCO2/bVOC fields are only published once BSEC has produced a value after a burn-in period (~5 min on a seasoned sensor, 20-30 min factory-new); iaq_acc climbs 0 to 3 and the BSEC state is persisted to NVS once accuracy reaches >=3 so a restart resumes near the last calibration; a configurable board self-heating offset (default 4.0C) is subtracted before BSEC processing.",
      "evidence": [
