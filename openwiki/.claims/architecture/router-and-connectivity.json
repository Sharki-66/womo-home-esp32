  "claims": [
    {
      "id": "claim_5c481446f5aa40349c04402e230b10fd",
      "statement": "The Teltonika RUTX11 router is a commercial OpenWrt-based device (configured via UCI/ubus, not built from this repository) that is the third physical node of the WoMoHome system, connected to the vehicle's 12V system via two relays with flyback diode and trailing delay, and using a roof antenna with 2x Wi-Fi, 2x LTE, and 1x GNSS element.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L11-L13",
          "version": "repo-lines-v1:sha256:eab523bf3e92b27c34fcf5ab375567aab70bfe818b458f2b8add8f869033f70d:"
        }
      ]
    },
    {
      "id": "claim_ab397b12e0fd4a54b277d72bfb3a7edd",
      "statement": "Only the Display (not the Sensorboard) manages the RUTX11 router's UCI/ubus API; the Sensorboard's own Wi-Fi connection is used only for NTP sync and its local HTTP dashboard, never to reach the router's management API.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L52-L52",
          "version": "repo-lines-v1:sha256:c470855954fecd3742a81b84872c39a355f1751693af683c928a3c499371b50b:"
        },
        {
          "resource": "repo://firmware/display/main/network/womo_router_uci.c#L7-L19",
          "version": "repo-lines-v1:sha256:01c2857eb258853434c9c9e1f60262ffac0b4453a70e56a737866e8579f64332:"
        }
      ]
    },
    {
      "id": "claim_81044740e8af43ebb61fbf4aacd8420a",
      "statement": "womo_router_uci.c communicates with the RUTX11 via JSON-RPC 2.0 over HTTP POST to the router's /ubus endpoint (default IP 192.168.55.1), using a mutex-serialized synchronous client that logs in for a ubus_rpc_session token (300s server timeout, refreshed 30s before expiry) and auto-relogs on permission errors.",
      "evidence": [
        {
          "resource": "repo://firmware/display/main/network/womo_router_uci.c#L1-L77",
          "version": "repo-lines-v1:sha256:0988056b3be63d01beefac8a61948338c971ac1438e50a3611045ff64e8da1f6:"
        }
      ]
    },
    {
      "id": "claim_554ab332117f4a83a7c55a74d65f07c9",
      "statement": "womo_router_is_reachable() checks only whether the ubus login/session succeeds, independent of whether the Wi-Fi STA uplink is currently connected, so a 'router reachable' status does not imply internet connectivity.",
      "evidence": [
        {
          "resource": "repo://firmware/display/main/network/womo_router_uci.h#L111-L119",
          "version": "repo-lines-v1:sha256:18a0e8aa55d291b81c9e1ac52e219a3a128633225eb99e2910d11f1af30fcb5f:"
        }
      ]
    },
    {
      "id": "claim_830d20eb6fbd42fb9ce620e2f0b8cbe9",
      "statement": "A dedicated router_poll_task in main.c polls the router's Wi-Fi/LTE/AP status every 15 seconds (ROUTER_POLL_INTERVAL_MS=15000) and the data-pass volume roughly every 30 minutes (ROUTER_DATAPASS_POLL_CYCLES), writing results into mutex-protected snapshot globals; on Wi-Fi loss it clears cached Wi-Fi/LTE state and resets its poll counter for fast reconnect pickup.",
      "evidence": [
        {
          "resource": "repo://firmware/display/main/main.c#L184-L196",
          "version": "repo-lines-v1:sha256:172dd066c41123624ae2bc17c7d59e7e39a97d562abba72cfe79b12ac39dbab3:"
        },
        {
          "resource": "repo://firmware/display/main/main.c#L2946-L3056",
          "version": "repo-lines-v1:sha256:faf9b5d47a83895a2293171e36f9e06b839ee1c9e4b9a42cc206201cd4c7aca6:"
        }
      ]
    },
    {
      "id": "claim_b0da3c952c4e479e82df189c023b34bc",
      "statement": "GPS, LTE, and Wi-Fi status are not transmitted over the Sensorboard-Display link (named 'RS485' in source/docs); the periodic ctrl topic from the Sensorboard only carries pwr_on/radio_on/ac_present, and router-derived data is written into the Display's merged snapshot exclusively by router_poll_task, independent of the Sensorboard link.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L27-L27",
          "version": "repo-lines-v1:sha256:94d838a1c7a800fa3a33b5fa1c430a550a4604880c2852694c87e867d8cb1cf5:"
        },
        {
