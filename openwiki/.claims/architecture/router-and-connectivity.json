    {
      "id": "claim_2c3cbc7a1ddc42908ce91905b149cebd",
      "statement": "womo_router_wifi_scan() scans only the router's AP/Master-mode Wi-Fi interfaces and explicitly excludes any actively-associated Client/STA interface (device_scan_would_disrupt: mode=='Client' with a non-empty, non-zero BSSID), because scanning an actively connected uplink radio forces a cross-channel hardware scan that was observed to freeze the router's connection on 2026-08-30 (RUTX11, radio0/wlan0=AP, radio1/wlan1=connected STA); an unassociated STA interface is unaffected and scanned normally.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L50-L50",
          "version": "repo-lines-v1:sha256:dbdd8bdec9e1cc3eacdd9f99ae433684923fccf9bb27e39b7d4f1820fc3e1672:"
        },
