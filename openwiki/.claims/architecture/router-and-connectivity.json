          "version": "repo-lines-v1:sha256:80a3cb31226cf1c9723a65ad7267f67cf8548397fcbdd2c6fa22faadaf3540a9:"
        }
      ]
    },
    {
      "id": "claim_ceaa99f7d2ff4187abaa4f451000dc43",
      "statement": "The Display's connectivity modal is a 640x420px, 3-column LVGL panel (HotSpot/AP | WLAN | LTE); WLAN and LTE columns show a status LED, connection name/signal, and an on/off switch (womo_router_wifi_set_sta/womo_router_wifi_enable_sta for WLAN, womo_router_lte_enable for LTE), each with a 45s cooldown (SWITCH_COOLDOWN_MS) after toggling before the next toggle is accepted.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L46-L51",
          "version": "repo-lines-v1:sha256:16a9ded504bc4371b33c23098a0ddbfa543eae904e47c446c456051446f6c947:"
        },
        {
