    {
      "id": "claim_99a1481580fb4252a54ff5a90069b2ea",
      "statement": "womo_router_wifi_set_sta() automatically selects between two fixed RUTX11 STA sections based on the target network's channel (>=36 => 5GHz on radio1, independent of the AP; else 2.4GHz on radio0, combined with the AP on the same channel), enabling the chosen section and disabling the other.",
      "evidence": [
