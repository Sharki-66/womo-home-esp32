          "version": "repo-lines-v1:sha256:aeef176d56e334ca2341e5dfeae2472a7a0b37c44d0abe425410dc151e4e440a:"
        }
      ]
    },
    {
      "id": "claim_c1b8e60bbdad4bf48420c7230c4de770",
      "statement": "The ESP32-C3 GasBee (firmware/gasbee) is legacy: the Sensorboard no longer uses it, and its only remaining purpose is the custom GATT service for third-party BLE clients (e.g. phone apps), since it has no advertising-based data path and requires a connection to read values.",
      "evidence": [
        {
          "resource": "repo://firmware/gasbee/main/ble_gas.c#L250-L270",
          "version": "repo-lines-v1:sha256:2941f25bef6c616b2b3a36161e9e3868b964051c36d9b8e531c3a8a85d9349eb:"
        },
