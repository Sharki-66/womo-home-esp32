    {
      "id": "claim_68d448b3e4844dd3b8a58334ea7300bc",
      "statement": "GasBee nRF (Seeed XIAO nRF52840 Sense) is the current, active gas-bottle scale firmware/hardware, replacing the ESP32-C3-based firmware/gasbee; the Sensorboard consumes it exclusively via passive BLE advertising scan (gasbee_ble_scanner.c -> sensors/gas_source.c) and never connects to it in normal operation.",
      "evidence": [
        {
          "resource": "repo://firmware/gasbee_nrf/README.md#L1-L4",
          "version": "repo-lines-v1:sha256:503b5d578d38e51428fbae979cf1608f15c89a2beadf5b6c3a86ceed3a327e07:"
        },
        {
