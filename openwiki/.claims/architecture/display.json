    {
      "id": "claim_4c4cad9614b84548ad2f8620d0476a91",
      "statement": "The project's README/CLAUDE.md document a physical RS485 UART link (UART2, 57600 8N1, half-duplex DE/RTS, CRLF-terminated ASCII-JSON lines) between Display and Sensorboard, with the Sensorboard-side pins (TX=GPIO12, RX=GPIO11, DE/RTS=GPIO21) being that board's own local pinout for the shared physical RS485 pair, distinct from the Display's own local UART pin assignment.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L17-L20",
          "version": "repo-lines-v1:sha256:609359288280541c2d9535ce7d95d89843f6c58cbe5aa62db27259e4c3c030b2:"
