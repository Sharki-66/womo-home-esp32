    {
      "id": "claim_bc39fa8c51b841c59e84214e45775d3c",
      "statement": "The Display node (Waveshare ESP32-S3-Touch-LCD-7) is the system's only network-facing node: it polls the Teltonika RUTX11 router directly for WLAN/LTE/GPS status and control, and is the only node making outbound HTTPS calls to external APIs (Open-Meteo, Nominatim, Meteoalarm); the Sensorboard never talks to the router or the internet directly.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L37-L37",
          "version": "repo-lines-v1:sha256:80a3cb31226cf1c9723a65ad7267f67cf8548397fcbdd2c6fa22faadaf3540a9:"
