          "version": "repo-lines-v1:sha256:a59907f0f1cebc084bc7a045c4a679a7c5d1287b817e344ca766d4d9d8ab1773:"
        }
      ]
    },
    {
      "id": "claim_f042e4bc917248b39ed42288dba4c726",
      "statement": "A missing/disconnected load cell while the wired HX711 module itself is present is not detectable by the firmware and is explicitly an unsupported mixed-operation configuration; in the field a Sensorboard either has the complete wired HX711 scale or relies entirely on GasBee BLE, never a mix.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/README.md#L80-L80",
          "version": "repo-lines-v1:sha256:70b375f1422189f5e239700a165f4f1657facdb68c724f79642109ddaf759920:"
        },
