        }
      ]
    },
    {
      "id": "claim_0091b6c0fb9548468824d4c907cf8e04",
      "statement": "gas_source.c arbitrates the gas-weight source for every downstream publisher (hx topic, gas topic, HTTP dashboard) with HX711-cable-has-priority as an unconditional invariant: if hx711_app_get_snapshot() reports at least one valid channel, the wired HX711 is used for both channels and GasBee is not consulted at all; only when no wired HX711 data is present are the configured GasBee slots checked for freshness (valid and within SENSOR_GASBEE_STALE_MS of the last new sequence number); if neither source is available the result is GAS_SRC_NONE (nc on both channels).",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/sensors/gas_source.c#L52-L74",
          "version": "repo-lines-v1:sha256:1db6942ac62e1ebce88bdbda8f0a9e12b43b414140e7fd121bb00bcc3803d95e:"
        },
        {
