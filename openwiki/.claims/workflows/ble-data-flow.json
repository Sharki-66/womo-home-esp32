          "version": "repo-lines-v1:sha256:7a5653b0c4d37a9bd09a447fc5e7ee3a0aa3533f3fdcb7b278dbe5a1c4c0b081:"
        }
      ]
    },
    {
      "id": "claim_8d4e79968f544df3b84ba63f85c40063",
      "statement": "gasbee_ble_scanner.c identifies GasBee advertisements by Complete Local Name \"GasBee\" plus Manufacturer Data Company-ID 0xFFFF with format version 1 (dropping unknown versions), routes packets to bottle slot A or B purely by matching the advertiser's BLE address against MAC filters loaded from NVS namespace gasbee_cfg and configurable at runtime via RS485 cmd:\"gasbee_config\", and de-duplicates each 10-packet burst by only evaluating the first packet of a sequence number different from the last one seen.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/README.md#L64-L69",
          "version": "repo-lines-v1:sha256:83ebb967a151633c1d35d6f1924006a2a41de7408c947bac157e32168d8707e2:"
