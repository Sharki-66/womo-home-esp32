  "claims": [
    {
      "id": "claim_624fabf7452a49cd91221da4b08d6ddc",
      "statement": "The GasBee nRF BLE advertising payload (Format v1, Manufacturer Specific Data under Company-ID 0xFFFF) consists of exactly 7 bytes: format version (byte 0), gross weight as int16 LE in 10 g units without tare (bytes 1-2, 0x8000 = invalid), battery voltage as uint16 LE in mV (bytes 3-4, 0xFFFF = invalid), a sequence counter incremented per measurement cycle (byte 5), and a flags byte (byte 6: bit0 HX711 ok, bit1 charging, bit2 calibrated, bit3 configuration mode, bits4-7 reserved) — no other fields exist in this format.",
      "evidence": [
        {
          "resource": "repo://firmware/gasbee_nrf/README.md#L75-L93",
          "version": "repo-lines-v1:sha256:8535ece88035d83cd71ce442bbd6df360b5761be90787968090d92fa033e4c40:"
        },
        {
          "resource": "repo://firmware/sensorboard/README.md#L62-L78",
          "version": "repo-lines-v1:sha256:b37d9f9eaeff9441de9761985322be389bbfbe702caf6ed5e43705849ec17b64:"
        },
        {
          "resource": "repo://firmware/sensorboard/main/network/gasbee_ble_scanner.c#L13-L28",
          "version": "repo-lines-v1:sha256:31b89f236293af72cf6044d3b16a26c816af513cecf221c53289f2eaedaca46b:"
        }
      ]
    },
    {
      "id": "claim_3c6ec2c379be46c68dd68c6ebd72f5f3",
      "statement": "The GasBee measures on a 5-minute cycle (1-minute in test mode) and then transmits a burst of 10 identical-sequence advertising packets spaced 1 second apart, followed by radio silence; while attached to USB it switches within 2 seconds to a continuous once-per-second, connectable configuration mode with 5-second measurement cadence and sets flag bit 3.",
      "evidence": [
        {
          "resource": "repo://firmware/gasbee_nrf/README.md#L53-L73",
          "version": "repo-lines-v1:sha256:1631292fdb57ea872ab76691a1c87fc14a1d954a70816d2fd986b3a39d46c708:"
        }
      ]
    },
    {
      "id": "claim_d2f65805d65d401482b88edcbfea23a8",
      "statement": "ble_manager.c is the sole owner of the Sensorboard's NimBLE stack: it initializes NimBLE once, runs a passive scan with filter_duplicates=0 so periodic Ruuvi/GasBee re-advertisements are not suppressed, dispatches every discovery event to up to four registered advertisement handlers, and automatically restarts scanning after any GATT connect or disconnect.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/network/ble_manager.c#L10-L86",
          "version": "repo-lines-v1:sha256:071762f6b9b9fa430077a07bba856dd72dcb2cf2077da963604be7abb5903c76:"
        },
