    {
      "id": "claim_c2b744e3eb774ed289adff60e2c3c119",
      "statement": "Issuing pwr_12v_off schedules a deep-sleep entry after the command ACK is sent, and deep_sleep_enter() independently re-pulses GPIO12 before putting the board to sleep, i.e. the OFF relay pulse is effectively fired twice (once from the command handler, once from the sleep path).",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/hal/deep_sleep.c#L173-L183",
          "version": "repo-lines-v1:sha256:f0d590a2639deadcb0b441b76ead2f55ebf692a28ad32df37b56ca8298341652:"
        },
        {
