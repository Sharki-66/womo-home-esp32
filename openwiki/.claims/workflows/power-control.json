    {
      "id": "claim_5d17407209414834b436d683e164ec65",
      "statement": "The ctrl topic's pwr_on field reports the GPIO14 sense-measured 12V rail state when SENSOR_PWR_12V_SENSE_ENABLE is set, but continues reporting the last commanded state for SENSOR_PWR_12V_SENSE_GRACE_MS (2500 ms) after any relay pulse before trusting the sense pin; polarity is controlled by SENSOR_PWR_12V_SENSE_ACTIVE_HIGH, which firmware comments mark as unverified by measurement.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/network/espnow_modem.c#L559-L593",
          "version": "repo-lines-v1:sha256:940f988b439911fc7686c5d6776664db9be6f13df4d6c42fe3a687714a68958d:"
        },
        {
          "resource": "repo://firmware/sensorboard/main/sensor_config.h#L226-L236",
          "version": "repo-lines-v1:sha256:5a8edc7e28bb1937dced6316b9a761fa2eac297545dfd53ea7131cf31dbe1113:"
        }
