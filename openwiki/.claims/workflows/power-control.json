  "claims": [
    {
      "id": "claim_5a72ebe543ac4a269bb2cebc1a26edf4",
      "statement": "GPIO11 and GPIO12 drive a bistable (latching) 12V house-battery relay via short coil pulses and must otherwise idle LOW, since an accidental pulse would switch the house battery on/off the 12V bus.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/CLAUDE.md#L16-L18",
          "version": "repo-lines-v1:sha256:c94cce0dd159c86e423fb64ce472f399af19a8dfc85942f21ce0c053036bb8f5:"
        },
        {
          "resource": "repo://firmware/sensorboard/main/app_main.c#L110-L126",
          "version": "repo-lines-v1:sha256:bb9e126a4d4ff46d76f87db7d0e32049129780fdd8e418bfc196a92cf45a03e1:"
        }
      ]
    },
    {
      "id": "claim_9a87ca70014a4d2f853174ad3d5cd773",
      "statement": "The cmd dispatcher in network/espnow_modem.c handles pwr_12v_on/pwr_12v_off/radio_on/radio_off: pwr_12v_on pulses GPIO11, pwr_12v_off pulses GPIO12 and forces radio off, radio_on is rejected with ESP_ERR_INVALID_STATE unless the 12V rail is on, and radio_off always sets GPIO13 LOW.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/network/espnow_modem.c#L1507-L1521",
          "version": "repo-lines-v1:sha256:9f39262d6b17cfbd3405d71cc488fa818126fdd6f2943ee89043da2588d48251:"
        },
        {
          "resource": "repo://firmware/sensorboard/main/network/espnow_modem.c#L600-L631",
          "version": "repo-lines-v1:sha256:33691daa6eacd212c654f8e4ed0ee1268ecdd4b3d5259eb65c781c1dba56740e:"
        }
      ]
    },
    {
      "id": "claim_8dbf25837c994ba8a66b2aedd9ca6c1b",
      "statement": "A single constant SENSOR_PWR_12V_PULSE_MS (500 ms) is used identically for the boot EIN-pulse, the runtime command pulse, and the deep-sleep AUS-pulse; 100 ms was previously tried and found insufficient to reliably switch the physical relay.",
      "evidence": [
