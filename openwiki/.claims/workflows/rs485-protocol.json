    {
      "id": "claim_434bfc01b50b4bff9de1bb99da4c28ed",
      "statement": "sensorboard/README.md and display/CLAUDE.md disagree on hb and hello topic field lists (README's hb includes heap and lacks rx_seq/last_ack; README's hello includes board and ts which CLAUDE.md omits while CLAUDE.md adds rx_seq/last_ack), on tank's field list (CLAUDE.md omits the t1_l/t2_l and rate/rest_h consumption fields that README documents), and on where pressure-trend fields apply (CLAUDE.md lists press_trend_state/press_trend_hpa_h for bme_in, but README documents trend fields only for bme_out).",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L23-L39",
          "version": "repo-lines-v1:sha256:9c8bf76580416a5f8d655417a8b55a44cf6dc0ef17c2530a4a167731dab52401:"
