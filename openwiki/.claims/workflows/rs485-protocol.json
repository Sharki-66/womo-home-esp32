          "version": "repo-lines-v1:sha256:f75d5117a6412d793f3074856e3cd090e6233877edcc33cb785427f680e9ad27:"
        },
        {
          "resource": "repo://firmware/sensorboard/main/network/espnow_modem.c#L1677-L1682",
          "version": "repo-lines-v1:sha256:d43ab024a419880e8ed897a34180c64aac658aa96f7e3b905c8c67c674cf0301:"
        }
      ]
    },
    {
      "id": "claim_577e998ef7174aeca95c6844cf8ec828",
      "statement": "On the Display side, each received topic updates only its own slice of the merged sensor-data snapshot, leaving all other fields untouched, and unknown or missing JSON fields are tolerated rather than treated as errors.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L41-L41",
          "version": "repo-lines-v1:sha256:12277c82beddad3e53c7bbc0fa84a4dce42dff2af42e14844a2eadd7c8ce427d:"
        }
      ]
    },
    {
      "id": "claim_aa5bb612d7a0497ba2b936668160f590",
      "statement": "Pending need_ack commands are tracked in a fixed-size table (WOMO_SENSOR_MAX_PENDING_CMDS = 4 slots); a command exceeding WOMO_SENSOR_COMMAND_TIMEOUT_MS (3000 ms) logs a one-time warning, and the slot is force-freed after 3x that timeout (9 s) regardless of whether an ACK arrives, so a lost ACK cannot permanently exhaust the pending-command pool; a 5th concurrent need_ack send fails to register a slot but the frame is still sent.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/network/espnow_modem.c#L165-L226",
          "version": "repo-lines-v1:sha256:7ff9b59f730901d66dd381e85596fea7ec658369d4e37ba0355d73d6e497e549:"
        },
        {
          "resource": "repo://firmware/sensorboard/main/network/espnow_modem.c#L254-L257",
          "version": "repo-lines-v1:sha256:946cd49d096de9766700ee9161230771e3bc13f8ff0def756784a5cfcd7b36e8:"
        },
        {
          "resource": "repo://firmware/shared/womo_config.h#L29-L37",
          "version": "repo-lines-v1:sha256:8f14f703bccd5b726f170339e78e4e8aa878b03357cc471c3a67ba613d596266:"
        }
      ]
    },
    {
      "id": "claim_0d02e0a7c8de4f759268e7a7b4e13566",
      "statement": "A pwr_12v_off command arms a deep-sleep-pending flag that only fires after that command's own ACK has been sent, guaranteeing the Display sees the command acknowledged before the Sensorboard enters deep sleep.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/network/espnow_modem.c#L1511-L1515",
          "version": "repo-lines-v1:sha256:eead2a31bacbabb032e8fabf71b2827e4b2e86680c7a16f9cc9151bae9aed2c8:"
