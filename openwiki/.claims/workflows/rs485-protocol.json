    },
    {
      "id": "claim_2e6e998e982944688dad8faf6cad1dc9",
      "statement": "The Display-originated command set (display_ready, level_start/stop, tare_a/b, gas_bottle_replace, pwr_12v_on/off, radio_on/off, ruuvi_config, ruuvi_scan_request, gasbee_config, gasbee_scan_request, gasbee_cal_start/end, gasbee_cal, wifi_config) is acknowledged by the Sensorboard via ACK, but the Sensorboard's current command handler has removed level_start/level_stop support (fast-mode is now driven automatically by /api/imu polling), so those two still-documented commands now receive an 'unknown command' ACK failure.",
      "evidence": [
        {
          "resource": "repo://firmware/display/CLAUDE.md#L38-L38",
