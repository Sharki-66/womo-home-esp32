    {
      "id": "claim_e4b2a115cbd5478e98d72bea792fcc75",
      "statement": "Each calibration step sends cmd 'gasbee_cal' with mac, step ('zero'/'ref'), and for 'ref' a gram value; gasbee_gatt_cal_start is the sole code path that opens a GasBee GATT connection, refuses to start if the GasBee was not seen in config mode within SENSOR_GASBEE_CFG_MAX_AGE_S or if another step is already busy, and allows only one calibration connection at a time system-wide.",
      "evidence": [
        {
          "resource": "repo://firmware/display/main/gui/womo_settings_modal.c#L1570-L1602",
          "version": "repo-lines-v1:sha256:088ab095ccd0e7325a20f0d5358ec70e2f4fb5af2b0f8ed39ce197acf0d8a484:"
        },
