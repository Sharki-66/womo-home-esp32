        },
        {
          "resource": "repo://firmware/sensorboard/main/network/gasbee_gatt_cal.h#L18-L22",
          "version": "repo-lines-v1:sha256:01d68bba94d30470a02dbb43d23724ed0df65f9e2909e5f6d1f6aa9799764637:"
        }
      ]
    },
    {
      "id": "claim_4c3e19eeaa874c15951c27f4212d892a",
      "statement": "The GasBee switches into USB configuration mode within at most 2 seconds of VBUS detection, advertising continuously once per second (flag bit 3 set) and measuring every 5 seconds instead of its normal 300-second burst cycle; calibration characteristics 0x2B11-0x2B13 reject writes with ATT error 'Write Not Permitted' while on battery power, and unplugging USB disconnects any open GATT link and returns it to normal operation.",
      "evidence": [
        {
          "resource": "repo://firmware/gasbee_nrf/README.md#L63-L69",
          "version": "repo-lines-v1:sha256:a95bc63dc411db82697a64e4c31546f7ceead3d6be8c39e5a3bf20ba2935909f:"
