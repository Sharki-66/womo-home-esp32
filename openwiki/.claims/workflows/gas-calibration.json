    {
      "id": "claim_07126905a7144c6d89b14eb81f98dd85",
      "statement": "gasbee_gatt_cal connects by address/address-type from the scan list, discovers GATT service 4a5b6c7d-8e9f-0a1b-2c3d-4e5f60718293 by UUID then its characteristics, writes a single byte 0x01 to characteristic 0x2B11 for the zero step or a 4-byte little-endian uint32 gram value to 0x2B12 for the reference step, reports the result exactly once from the ATT write callback, and immediately terminates the connection regardless of outcome under a SENSOR_GASBEE_CAL_TIMEOUT_MS (15s) guard timer.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/network/gasbee_gatt_cal.c#L116-L158",
          "version": "repo-lines-v1:sha256:e03dfe95cb604b1eaf7750a6444a1f82d87f0de4feab4d2e716cfe52cd696b46:"
        },
        {
