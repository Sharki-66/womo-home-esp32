    {
      "id": "claim_b7ae8852e8f647d7aae3bb910a963ce2",
      "statement": "While a GATT connection to a GasBee is open for any reason (calibration or a third-party client), the GasBee suspends its advertising bursts entirely, so the Sensorboard's passive scanner sees no updates for that device until the connection ends.",
      "evidence": [
        {
          "resource": "repo://firmware/gasbee_nrf/README.md#L95-L99",
          "version": "repo-lines-v1:sha256:49901f42f1104ad36ee4c7d34830ce5af0050a5fef023cbeff25d895fbb15819:"
        }
      ]
    },
    {
      "id": "claim_8ba30fce7a734d6b9be22deebcd65be7",
      "statement": "Sensorboard-local calibration failures are reported as negative codes (GASBEE_CAL_ERR_BUSY, GASBEE_CAL_ERR_NOT_FOUND, GASBEE_CAL_ERR_CONNECT, GASBEE_CAL_ERR_NO_SERVICE, GASBEE_CAL_ERR_TIMEOUT, GASBEE_CAL_ERR_DISCONNECT, GASBEE_CAL_ERR_ARG, GASBEE_CAL_ERR_BLE) while positive codes are ATT errors echoed from the GasBee itself (e.g. 0x03 not in configuration mode, 0x0D wrong length, 0x13 invalid value), all converted to human-readable text by gasbee_gatt_cal_result_str and forwarded to the Display in a gasbee_cal_result frame.",
