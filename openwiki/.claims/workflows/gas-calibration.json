    {
      "id": "claim_0480419399a448babd0fef81c758c2ee",
      "statement": "A successful GATT write to 0x2B11/0x2B12 only confirms the GasBee accepted the write format, not that calibration is durably in effect; the Display verifies actual success purely through subsequent advertising, requiring flag bit 2 (calibrated) set, the sequence counter advanced by at least 2 measurement cycles since the reference write, and the reported weight within the greater of ±1% (GBW_TOL_REL) or ±50g (GBW_TOL_ABS_KG) of the entered reference weight, with a GBW_VERIFY_TIMEOUT_MS (20s) timeout leading to a retry.",
      "evidence": [
        {
          "resource": "repo://firmware/display/main/gui/womo_settings_modal.c#L1495-L1502",
          "version": "repo-lines-v1:sha256:2f50bd2c72486a6957a86907cfa889deae3887b323a60210c27948684cd871c6:"
        },
        {
          "resource": "repo://firmware/display/main/gui/womo_settings_modal.c#L1858-L1888",
