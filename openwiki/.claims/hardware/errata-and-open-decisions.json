  "claims": [
    {
      "id": "claim_0e858af9507d433284217ba03ec81d27",
      "statement": "The Sensorboard's J7 driver transistors Q1/Q2 for the 12V house-battery relay 'ON'/'OFF' pulses (GPIO11/GPIO12) are populated as IRLML2244 P-channel high-side switches that place +12V on the J7 pin when active, whereas the Schaudt EBL's 'Ein'/'Aus' relay inputs expect a low-side pull-to-GND pulse; as a result the EBL's internal bistable relay never switches, regardless of pulse length or the GPIO14 sense reading.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/CLAUDE.md#L16-L18",
          "version": "repo-lines-v1:sha256:c94cce0dd159c86e423fb64ce472f399af19a8dfc85942f21ce0c053036bb8f5:"
        },
        {
          "resource": "repo://firmware/sensorboard/memory-bank/progress.md#L44-L45",
          "version": "repo-lines-v1:sha256:06733176d07648f21c3b9714445823c5b1980d9f94150d96d3cd3d49246f119b:"
        }
      ]
    },
    {
      "id": "claim_0f27931f68b744439a3f421569f66251",
      "statement": "The identified fix for the Q1/Q2 polarity bug is a same-footprint swap to IRLML6244 (N-channel), contingent on the transistor source already being wired to GND, and this fix had not yet been verified on hardware as of the latest progress notes.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/CLAUDE.md#L18-L18",
          "version": "repo-lines-v1:sha256:fdc96ac58cf9e4f026fddad7128de2cf26cc2db8e641e6a665ad75b534037ebd:"
