    {
      "id": "claim_895933b0158b43419d0f58d816296122",
      "statement": "The GasBee nRF's LiPo battery percentage curve (SENSOR_GASBEE_LIPO_CURVE) has not been verified against a real battery's discharge behavior; only a single near-full-charge voltage spot-check (multimeter 4.025V vs. reported 4.003V) has been performed, which does not validate the percentage curve across the discharge range.",
      "evidence": [
        {
          "resource": "repo://firmware/gasbee_nrf/README.md#L250-L250",
