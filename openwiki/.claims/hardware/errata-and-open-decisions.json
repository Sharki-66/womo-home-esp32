        }
      ]
    },
    {
      "id": "claim_14d431f7b2fd4625b1c497a24af5a5dc",
      "statement": "A 2026-08-30 reversed-polarity connection at connector J7 physically damaged the Sensorboard's GPIO13 (multimedia) output driver (hard short to GND) and GPIO17 (light, swapped 12V control signal), while GPIO18 (pump) survived the same incident; GPIO11/GPIO12 (12V relay) are also routed through J7 and are suspected, but not conclusively verified, to be damaged as well. No firmware workaround exists, and a new PCB revision was ordered rather than remapping pins on the damaged board.",
      "evidence": [
        {
          "resource": "repo://firmware/sensorboard/main/sensor_config.h#L237-L245",
          "version": "repo-lines-v1:sha256:a4a9908484da4f141075a7e30513061de08e9c2089fe4671ccdf020063bb995d:"
