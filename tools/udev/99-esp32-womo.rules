# WoMoHome – feste Symlinks für die seriellen Ports aller Boards
#
# Zweck: /dev/ttyACMx wechselt bei jedem Neuanstecken. Über die USB-Seriennummer
# bekommt jedes Board einen festen Namen. Ist ein Board nicht angesteckt, fehlt
# sein Symlink → Flashen schlägt fehl statt auf dem falschen Board zu landen.
#
# Installieren (sudo nötig):
#   sudo cp tools/udev/99-esp32-womo.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules && sudo udevadm trigger
# Prüfen:
#   ls -l /dev/ttyESP_* /dev/ttyGASBEE_*
# Werte eines neuen/getauschten Boards auslesen (Board einzeln anstecken):
#   udevadm info -a -n /dev/ttyACM0 | grep -E 'ATTRS\{(idVendor|idProduct|serial)\}' | head -3
#
# Verwendet in: womo-*.code-workspace (idf.port + Tasks) sowie firmware/*/.vscode/{settings,tasks}.json

# Sensorboard: ESP32-S3-WROOM-1 N16R8 (Espressif native USB)
# Neue Platine, Seriennummer ausgelesen 2026-10-17 (alte Platine war 1C:DB:D4:74:8D:E4)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
ATTRS{serial}=="44:1B:F6:CF:04:1C", SYMLINK+="ttyESP_SENSOR"

# Display: ESP32-S3-Touch-LCD-7 (Espressif native USB JTAG)
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
ATTRS{serial}=="50:78:7D:14:E3:CC", SYMLINK+="ttyESP_DISPLAY"

# GasBee: ESP32-C3 (Espressif native USB JTAG)
# TODO: Seriennummer eintragen – Board anstecken und mit udevadm (s. o.) auslesen.
# SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
#   ATTRS{serial}=="XX:XX:XX:XX:XX:XX", SYMLINK+="ttyESP_GASBEE"

# GasBee nRF: Seeed XIAO nRF52840 (USB-CDC-Log, firmware/gasbee_nrf) – beliebig viele
# Allgemeine Regel, kein Eintrag pro Gerät: jede GasBee bekommt automatisch
#   /dev/ttyGASBEE_<USB-Seriennummer>   (Seriennummer = Chip-ID über CONFIG_HWINFO)
# VID/PID 2fe3:0004 aus build/gasbee_nrf/zephyr/.config (CONFIG_CDC_ACM_SERIAL_VID/PID).
# Das ist die Zephyr-Standard-ID – andere Zephyr-Geräte würden ebenfalls erfasst.
# TODO: Sobald gasbee_nrf CONFIG_CDC_ACM_SERIAL_PRODUCT_STRING="GasBee" setzt, hier
#   zusätzlich ATTRS{product}=="GasBee" prüfen.
# Flashen läuft per UF2-Laufwerk (XIAO-SENSE), nicht über diesen Port.
# Monitor mit Geräteauswahl: tools/gasbee-monitor.sh
SUBSYSTEM=="tty", ATTRS{idVendor}=="2fe3", ATTRS{idProduct}=="0004", \
ATTRS{serial}=="?*", SYMLINK+="ttyGASBEE_$attr{serial}"
