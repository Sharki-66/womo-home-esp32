{
  "folders": [
    {
      "name": "📺 Display (firmware/display) - MAIN",
      "path": "firmware/display"
    },
    {
      "name": "🔧 Sensor (firmware/sensorboard) - REF",
      "path": "firmware/sensorboard"
    }
  ],
  "settings": {
    "idf.flashBaudRate": "460800",
    "idf.port": "COM5",
    "idf.openOcdConfigs": ["board/esp32s3-builtin.cfg"],
    "files.associations": { "*.h": "c", "*.c": "c" },
    "C_Cpp.default.compilerPath": "${config:idf.toolsPath}/tools/xtensa-esp32s3-elf/esp-13.2.0_20240530/xtensa-esp32s3-elf/bin/xtensa-esp32s3-elf-gcc",
    "C_Cpp.default.compileCommands": "${workspaceFolder:📺 Display (firmware/display) - MAIN}/build/compile_commands.json",
    "files.defaultLanguage": "c",
    "explorer.sortOrder": "foldersNestsFiles",
    "idf.showOnboardingOnInit": false,
    "idf.notificationSilentMode": false,
    "idf.enableUpdateSuggestions": true,
    "idf.enableStatusBar": true,
    "idf.enableCcache": false,
    "chat.agent.maxRequests": 50
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Build Display Firmware",
        "type": "shell",
        "command": "idf.py",
        "args": ["build"],
        "options": { "cwd": "${workspaceFolder:📺 Display (firmware/display) - MAIN}" },
        "group": { "kind": "build", "isDefault": true },
        "problemMatcher": ["$gcc"],
        "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false }
      },
      {
        "label": "Flash Display Firmware",
        "type": "shell",
        "command": "idf.py",
        "args": ["-p", "COM5", "flash"],
        "options": { "cwd": "${workspaceFolder:📺 Display (firmware/display) - MAIN}" },
        "group": "build",
        "problemMatcher": [],
        "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false }
      },
      {
        "label": "Monitor Display (COM5)",
        "type": "shell",
        "command": "idf.py",
        "args": ["-p", "COM5", "monitor"],
        "options": { "cwd": "${workspaceFolder:📺 Display (firmware/display) - MAIN}" },
        "group": "build",
        "isBackground": true,
        "problemMatcher": [],
        "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated", "showReuseMessage": false, "clear": false }
      },
      {
        "label": "Build + Flash + Monitor Display",
        "type": "shell",
        "command": "idf.py",
        "args": ["-p", "COM5", "build", "flash", "monitor"],
        "options": { "cwd": "${workspaceFolder:📺 Display (firmware/display) - MAIN}" },
        "group": "build",
        "isBackground": true,
        "problemMatcher": ["$gcc"],
        "presentation": { "echo": true, "reveal": "always", "focus": true, "panel": "dedicated", "showReuseMessage": false, "clear": false }
      },
      {
        "label": "Clean Display Build",
        "type": "shell",
        "command": "idf.py",
        "args": ["fullclean"],
        "options": { "cwd": "${workspaceFolder:📺 Display (firmware/display) - MAIN}" },
        "group": "build",
        "problemMatcher": [],
        "presentation": { "echo": true, "reveal": "always", "focus": false, "panel": "shared", "showReuseMessage": false, "clear": false }
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "espressif.esp-idf-extension",
      "ms-vscode.cpptools",
      "ms-vscode.cmake-tools"
    ]
  }
}
