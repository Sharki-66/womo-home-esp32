{
	"folders": [
		{
			"name": "📺 Display (firmware) - MAIN",
			"path": "firmware"
		},
		{
			"path": "firmware-modem"
		}
	],
	"settings": {
		"idf.flashBaudRate": "460800",
		"idf.port": "COM5",
		"idf.openOcdConfigs": [
			"board/esp32s3-builtin.cfg"
		],
		"files.associations": {
			"*.h": "c",
			"*.c": "c"
		},
		"C_Cpp.default.compilerPath": "${config:idf.toolsPath}/tools/xtensa-esp32s3-elf/esp-13.2.0_20240530/xtensa-esp32s3-elf/bin/xtensa-esp32s3-elf-gcc",
		"C_Cpp.default.compileCommands": "${workspaceFolder}/firmware/build/compile_commands.json",
		"files.defaultLanguage": "c",
		"explorer.sortOrder": "foldersNestsFiles",
		"idf.showOnboardingOnInit": false,
		"idf.notificationSilentMode": false,
		"idf.enableUpdateSuggestions": true,
		"idf.enableStatusBar": true,
		"idf.enableCcache": false,
		"chat.agent.maxRequests": 50
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Build Display Firmware",
				"type": "shell",
				"command": "idf.py",
				"args": ["build"],
				"options": {
					"cwd": "${workspaceFolder}/firmware"
				},
				"group": {
					"kind": "build",
					"isDefault": true
				},
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "shared"
				}
			},
			{
				"label": "Flash Display Firmware",
				"type": "shell",
				"command": "idf.py",
				"args": ["-p", "COM5", "flash"],
				"options": {
					"cwd": "${workspaceFolder}/firmware"
				},
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "shared"
				}
			},
			{
				"label": "Monitor Display (COM5)",
				"type": "shell",
				"command": "idf.py",
				"args": ["-p", "COM5", "monitor"],
				"options": {
					"cwd": "${workspaceFolder}/firmware"
				},
				"group": "build",
				"presentation": {
					"echo": true,
					"reveal": "always",
					"focus": false,
					"panel": "shared"
				}
			}
		]
	},
	"extensions": {
		"recommendations": [
			"espressif.esp-idf-extension",
			"ms-vscode.cpptools",
			"ms-vscode.cmake-tools"
		]
	},
	"keybindings": [
		{
			"key": "ctrl+shift+b",
			"command": "espIdf.buildProject",
			"when": "!inDebugMode"
		},
		{
			"key": "ctrl+shift+f",
			"command": "espIdf.flashDevice",
			"when": "!inDebugMode"
		},
		{
			"key": "ctrl+shift+m",
			"command": "espIdf.monitorDevice",
			"when": "!inDebugMode"
		},
		{
			"key": "ctrl+shift+a",
			"command": "espIdf.buildFlashMonitor",
			"when": "!inDebugMode"
		}
	]
}